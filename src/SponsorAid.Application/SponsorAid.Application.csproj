<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core application dependencies for messaging, CQRS, and localization -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- Clean architecture dependency: Application layer depends directly on Domain entities and rules -->
  <ItemGroup>
    <ProjectReference Include="..\SponsorAid.Domain\SponsorAid.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
	
  <!-- Shared Protobuf event schemas compiled to C# message classes without gRPC client stubs -->
  <ItemGroup>
    <Protobuf Include="..\..\contracts\events.proto" GrpcServices="None" />
  </ItemGroup>
	
  <!-- Embedded message resources for localized chatbot dialog text -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\BotMessages.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>
</Project>
