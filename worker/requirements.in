# Python package requirements for the SponsorAid worker service.
# Uses pip-tools to compile reproducible requirements.txt dependencies.

# Downloads CPU-only PyTorch wheels to avoid multi-gigabyte CUDA runtime packages.
--extra-index-url https://download.pytorch.org/whl/cpu 

# Web server for container health checks and diagnostics.
fastapi
uvicorn[standard]
pydantic
python-dotenv

# Message broker and contract serialization.
pika
aiohttp
# Runtime library for encoding and decoding shared Protocol Buffer contracts.
protobuf

# Computer vision and document extraction.
# Headless build includes WeChat QR code scanner without desktop X11 dependencies.
opencv-contrib-python-headless==4.10.0.84
# Pins NumPy below 2.3.0 to keep binary compatibility with OpenCV and PyTorch.
numpy<2.3.0
Pillow
pdfplumber

# Machine learning models for identity document orientation and text validation.
ultralytics
sentence-transformers

# Test runner for worker unit and integration tests.
pytest
